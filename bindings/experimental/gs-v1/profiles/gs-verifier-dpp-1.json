{
  "id": "https://vc4qi.example/profiles/gs-verifier-dpp",
  "version": "1",
  "status": "experimental",
  "description": "Verifier-owned reliance profile for experimental product passports (shaped after the EU Digital Product Passport, not ESPR conformance) under the GS certification v1 binding: the passport is relied on as the declaration of the responsible economic operator it names, and its GS-mark entry only through the cited GS-mark credential, which keeps its own route. Fictional.",
  "binding": {
    "id": "https://vc4qi.example/bindings/gs/1",
    "version": "1"
  },
  "trustAnchors": [
    {
      "id": "https://nab.vc4qi.example/controller",
      "purposes": [
        "accredit-certification-bodies",
        "accredit-testing-laboratories"
      ]
    },
    {
      "id": "https://zls.vc4qi.example/controller",
      "purposes": [
        "authorize-gs-certification"
      ]
    }
  ],
  "authority": {
    "certificateRoutes": [
      "responsible-economic-operator"
    ],
    "globalRestrictions": [],
    "maxRoutes": 4
  },
  "credentialStatus": {
    "required": true,
    "purposes": [
      "revocation"
    ],
    "maxAgeSeconds": 2592000
  },
  "mapping": {
    "methodSuccession": "none"
  },
  "conformity": {
    "requirements": [],
    "decisionRules": []
  }
}
