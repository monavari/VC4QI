{
  "$schema": "https://w3id.org/qi-vc/schemas/v1/policy-profile.schema.json",
  "id": "gs-scheme-authorization",
  "targetCredentialTypes": [
    "GSCertificate"
  ],
  "requiredEvidence": [
    {
      "id": "gs-scheme",
      "relation": "authorizedBy",
      "authorizationBasis": {
        "kind": "schemeAuthorization"
      },
      "required": true
    },
    {
      "id": "gs-competence",
      "relation": "authorizedBy",
      "authorizationBasis": {
        "kind": "accreditation"
      },
      "required": true
    }
  ],
  "checks": {
    "proof": "optional",
    "schema": "optional",
    "status": "optional",
    "digest": "required",
    "scopeInclusion": "ignored",
    "derivation": "scopeSubset",
    "cycleDetection": "required",
    "termsOfUse": "optional"
  },
  "limits": {
    "maxDepth": 8,
    "maxEvidenceNodes": 32
  }
}
